# Discord Agents - Environment Variables Template
# Copy this file to .env or deployment/.env and fill in your actual values

# ===== DISCORD BOT TOKENS =====
# Get from: https://discord.com/developers/applications
# Create a bot, enable MESSAGE CONTENT INTENT, and copy the token

# Main bot token (used by alpha bot by default)
ALPHA_BOT_TOKEN=your_discord_bot_token_here

# Additional bot tokens (for multi-bot setups)
BETA_BOT_TOKEN=your_second_bot_token_here

# ===== OPENAI-COMPATIBLE PROVIDER =====
# All model calls go to an OpenAI-compatible /chat/completions endpoint
# (OpenAI itself, OpenRouter, Together, Groq, a local vLLM/Ollama/LM Studio
# server, etc). No other provider mode exists.
#
# OPENAI_API_KEY: the key for your provider. Some local servers (Ollama,
#   LM Studio) ignore this - put any placeholder value.
# OPENAI_BASE_URL: the /v1 base URL. Examples:
#   https://api.openai.com/v1              (OpenAI)
#   https://openrouter.ai/api/v1           (OpenRouter)
#   https://api.together.xyz/v1            (Together)
#   http://localhost:11434/v1              (Ollama)
#   http://localhost:1234/v1               (LM Studio)
#   http://localhost:8000/v1               (vLLM, default port)
# OPENAI_MODEL: overrides bots/<bot>.yaml's api.model - the model name your
#   provider expects (e.g. gpt-4o, meta-llama/Llama-3.3-70B-Instruct, ...).
# OPENAI_MAX_OUTPUT_TOKENS: caps outgoing max_tokens per request. Optional;
#   the framework otherwise uses a conservative default.
# OPENAI_UTILITY_MODEL: model used for small internal helper calls (episode
#   distillation, watch-eval). Falls back to OPENAI_MODEL if unset.
#
OPENAI_API_KEY=your_provider_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_OUTPUT_TOKENS=16384
# OPENAI_UTILITY_MODEL=gpt-4o-mini

# ===== WEB SEARCH =====
# Web search and page fetch are client-side function tools backed by the free,
# keyless ddgs package. No API key is required. Enable them per bot with
# api.web_search.enabled: true in the bot's yaml.

# ===== OPTIONAL: PER-BOT API KEYS =====
# Uncomment to use different API keys for specific bots
# ALPHA_OPENAI_KEY=different_key_for_alpha_bot
# BETA_OPENAI_KEY=different_key_for_beta_bot

# ===== NOTES =====
# 1. NEVER commit this file to git after adding real values
# 2. Keep your tokens and API keys secure
# 3. Rotate keys immediately if exposed
# 4. Use deployment/.env for private configs that sync across machines

# Discord-Claude Bot Framework - Environment Variables Template
# Copy this file to .env or deployment/.env and fill in your actual values

# ===== DISCORD BOT TOKENS =====
# Get from: https://discord.com/developers/applications
# Create a bot, enable MESSAGE CONTENT INTENT, and copy the token

# Main bot token (used by alpha bot by default)
ALPHA_BOT_TOKEN=your_discord_bot_token_here

# Additional bot tokens (for multi-bot setups)
BETA_BOT_TOKEN=your_second_bot_token_here

# ===== LLM PROVIDER =====
# Which backend to use for all model calls. Default is Anthropic; set to
# openai_compatible to point this framework at any OpenAI-compatible
# /chat/completions endpoint (OpenAI itself, OpenRouter, Together, Groq,
# a local vLLM/Ollama/LM Studio server, etc).
#
# See OPENAI_COMPATIBILITY.md for exactly which features work in each mode -
# code execution/skills, the Files API, the built-in memory tool, native web
# search, and the weekly memory-reconsolidation (Batches API) pass are
# Anthropic-only and are cleanly disabled under openai_compatible.
LLM_PROVIDER=anthropic  # anthropic | openai_compatible

# ===== ANTHROPIC API KEY =====
# Get from: https://console.anthropic.com/
# Required when LLM_PROVIDER=anthropic (the default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== OPENAI-COMPATIBLE PROVIDER =====
# Required when LLM_PROVIDER=openai_compatible. Everything needed to point
# at a different API lives here - no code changes needed.
#
# OPENAI_API_KEY: the key for your provider. Some local servers (Ollama,
#   LM Studio) ignore this - put any placeholder value.
# OPENAI_BASE_URL: the /v1 base URL. Examples:
#   https://api.openai.com/v1              (OpenAI)
#   https://openrouter.ai/api/v1           (OpenRouter)
#   https://api.together.xyz/v1            (Together)
#   http://localhost:11434/v1              (Ollama)
#   http://localhost:1234/v1               (LM Studio)
#   http://localhost:8000/v1               (vLLM, default port)
# OPENAI_MODEL: overrides bots/<bot>.yaml's api.model - the model name your
#   provider expects (e.g. gpt-4o, meta-llama/Llama-3.3-70B-Instruct, ...).
# OPENAI_MAX_OUTPUT_TOKENS: this framework's per-model output-token ceiling
#   table only knows Claude model names; set this to your model's real cap
#   so requests aren't clamped to the (Claude) default.
# OPENAI_UTILITY_MODEL: model used for small internal helper calls (episode
#   distillation, watch-eval) that otherwise hardcode a Claude model name.
#   Falls back to OPENAI_MODEL if unset.
#
# OPENAI_API_KEY=your_provider_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_OUTPUT_TOKENS=16384
# OPENAI_UTILITY_MODEL=gpt-4o-mini

# ===== WEB SEARCH (used when LLM_PROVIDER=openai_compatible) =====
# Anthropic's native web_search/web_fetch have no OpenAI-compatible
# equivalent, so under openai_compatible mode these become normal function
# tools backed by the Brave Search API instead. Get a free-tier key at
# https://brave.com/search/api/ (2,000 queries/month free). Only used when
# config.api.web_search.enabled is true in the bot's yaml.
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ===== OPTIONAL: PER-BOT API KEYS =====
# Uncomment to use different API keys for specific bots
# ALPHA_ANTHROPIC_KEY=different_key_for_alpha_bot
# BETA_ANTHROPIC_KEY=different_key_for_beta_bot

# ===== NOTES =====
# 1. NEVER commit this file to git after adding real values
# 2. Keep your tokens and API keys secure
# 3. Rotate keys immediately if exposed
# 4. Use deployment/.env for private configs that sync across machines
